{
  "name": "bossforge-live",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @bossforge/shared build && dotenv -e .env -- concurrently -k -n server,web -c cyan,magenta \"pnpm --filter @bossforge/server dev\" \"pnpm --filter @bossforge/web dev\"",
    "build": "pnpm -r --sort --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --sort --if-present typecheck",
    "test": "pnpm --filter @bossforge/shared build && pnpm -r --if-present test",
    "simulate": "pnpm --filter @bossforge/server simulate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:prepare": "node tools/prepare-vector-assets.mjs",
    "assets:check": "node tools/prepare-vector-assets.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "svgo": "4.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
